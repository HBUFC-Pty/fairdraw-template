# Copy to .env and fill in. Never commit .env. Every variable is read and validated in src/lib/env.ts.
# Generate secrets with:  openssl rand -hex 32

# ---- Site and URLs -------------------------------------------------------------------------------------------------
# Public address of the site, no trailing slash. Must be https in production. Used for links in emails, payment
# return URLs and the Server Action origin check.
APP_URL=https://competitions.example.co.uk
# Domain Caddy requests a TLS certificate for (docker-compose.yml). Usually the host part of APP_URL.
SITE_DOMAIN=competitions.example.co.uk
# Email address Caddy gives Let's Encrypt for certificate expiry notices.
ACME_EMAIL=admin@example.co.uk
SITE_NAME=Example Competitions

# ---- Secrets -------------------------------------------------------------------------------------------------------
# Signs flash messages, encrypts TOTP seeds, keys the self-exclusion fingerprint and the test payment provider.
# At least 32 characters. Changing it logs nobody out but breaks existing 2FA set-ups: keep it stable and secret.
APP_SECRET=
# Keys the entry codes shown next to each ticket on public entry lists. At least 32 characters. Never publish it.
# Changing it changes every entry code, so set it once.
ENTRY_CODE_SECRET=

# ---- Database ------------------------------------------------------------------------------------------------------
# docker-compose.yml builds DATABASE_URL from POSTGRES_PASSWORD, so you normally only set the password.
POSTGRES_PASSWORD=
# For running outside Docker (pnpm dev), point at your own Postgres 16:
DATABASE_URL=postgres://fairdraw:change-me@localhost:5432/fairdraw
# Neon and other pooled hosts only: the direct (unpooled) URL. When set it is used instead of DATABASE_URL, because
# the worker's lock does not work through a transaction-mode pooler. The Vercel Neon integration sets it for you.
DATABASE_URL_UNPOOLED=
# Connections per app process.
DATABASE_POOL_MAX=10

# ---- Operator details (shown in the footer, terms and privacy notice) ---------------------------------------------
# Use exactly what Companies House shows: FairDraw checks that these match.
OPERATOR_LEGAL_NAME=[Operator Ltd]
OPERATOR_COMPANY_NUMBER=[company number]
OPERATOR_REGISTERED_ADDRESS=[registered office address]
# Your ICO data protection fee registration number.
OPERATOR_ICO_NUMBER=[ICO registration number]
CONTACT_EMAIL=hello@example.co.uk
# Must accept mail: test it. FairDraw checks the privacy contact works.
PRIVACY_EMAIL=privacy@example.co.uk
# Where free postal entries go. Shown on every competition page and in the terms.
POSTAL_ENTRY_ADDRESS=[postal entry address]
# The company that actually processes card payments, named in the privacy notice (for example "Stripe Payments UK Ltd").
PAYMENT_PROCESSOR_NAME=[payment processor]
# Set to true once you are on the gov.uk signatory list of the voluntary code for prize draw operators.
VOLUNTARY_CODE_SIGNATORY=false

# ---- Payments (docs/payments.md) -----------------------------------------------------------------------------------
# "test" for local development only (refused in production), or "stripe".
PAYMENT_PROVIDER=test
# Stripe secret key (sk_test_... while testing) and the signing secret of your webhook endpoint
# (https://your-domain/api/webhooks/stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leave false. Only for a private staging server that must use the test provider with NODE_ENV=production.
TEST_PAYMENTS_ALLOWED_IN_PRODUCTION=false
# Minutes a ticket is held while the player pays (30 to 120; Stripe Checkout needs at least 30).
RESERVATION_MINUTES=30

# ---- Email (SMTP) --------------------------------------------------------------------------------------------------
# Development: Mailpit (docker compose --profile dev up) listens on localhost:1025, web UI on http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS (port 465).
SMTP_SECURE=false
# With SMTP_SECURE=false, require STARTTLS. Defaults to true in production. Set false only for Mailpit in the dev profile.
SMTP_REQUIRE_TLS=
MAIL_FROM="Example Competitions <no-reply@example.co.uk>"

# ---- Security ------------------------------------------------------------------------------------------------------
# Session cookie is __Host- prefixed and Secure. Set false only for local development over plain http on a host other
# than localhost.
COOKIE_SECURE=true
# Trust X-Forwarded-For from Caddy for rate limiting. Keep true behind the bundled Caddy; false if the app is exposed
# directly.
TRUST_PROXY_HEADERS=true
# Extra https origins competition images may load from, comma separated (added to the CSP img-src).
IMAGE_HOSTS=

# ---- Draws ---------------------------------------------------------------------------------------------------------
# drand relays, comma separated. At least two must agree before a draw is made. Default: api.drand.sh, api2.drand.sh,
# api3.drand.sh and drand.cloudflare.com.
DRAND_RELAYS=

# ---- Serverless hosts and demos ------------------------------------------------------------------------------------
# Vercel and similar hosts only (docs/deploy-vercel.md): the bearer secret for POST /api/cron/tick, at least 32
# characters (openssl rand -hex 32). Leave empty on a server that runs the worker: the endpoint then does not exist.
CRON_SECRET=
# true only for a public demo of the template: a demo banner and hero, amounts shown as points and prizes of demo
# points, sign-up with made-up details and no email, visitors' accounts deleted after 24 hours, and fresh demo
# competitions. Needs PAYMENT_PROVIDER=test.
DEMO_MODE=false
